# Vilken version av imagen compose ska köra. Tom = latest.
# EXPENSEVIBE_VERSION=1.0.0

# Kopiera till .env. Committa aldrig .env själv.
#
# Både en bar `python manage.py runserver` (via python-dotenv) och
# docker-compose.yml (env_file + ${...}-interpolation) läser den här filen.

# Lokal utveckling utan Docker. docker-compose.yml sätter DJANGO_DEBUG=0
# oavsett, så raden påverkar inte compose-stacken.
DJANGO_DEBUG=1

# Generera en riktig för produktion med:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=byt-mig-lokalt

# Sätt till t.ex. http://127.0.0.1:5001 för att slå på ReInvGrabber-
# integrationen lokalt - tomt/osatt stänger av den helt. docker-compose.yml
# sätter den hårt mot reinvgrabber-tjänsten i samma nätverk.
REINVGRABBER_URL=
REINVGRABBER_TIMEOUT=15

# Värdport för nginx-tjänsten i docker-compose.yml.
NGINX_HTTP_PORT=80

# --- Produktion (docker-compose.yml-stacken) ---------------------------------
# Avkommentera och sätt riktiga värden vid driftsättning. Utan DATABASE_* körs
# appen mot sqlite - Postgres-stacken kräver allihop.

# DJANGO_ALLOWED_HOSTS=expensevibe.example.se
# EXPENSEVIBE_PUBLIC_URL=https://expensevibe.example.se
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=expensevibe
# DATABASE_USER=expensevibe
# DATABASE_PASSWORD=byt-mig
# DATABASE_HOST=db
# DATABASE_PORT=5432
# Läses även av db-tjänstens postgres-image.
# POSTGRES_DB=expensevibe
# POSTGRES_USER=expensevibe
# POSTGRES_PASSWORD=byt-mig
